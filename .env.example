# App Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
POSTGRES_DB=myride
POSTGRES_USER=myride
POSTGRES_PASSWORD=myride_dev_password
DATABASE_URL=postgresql://myride:myride_dev_password@localhost:5432/myride

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# LiveKit Configuration
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-dev-key-change-this-in-production
LIVEKIT_WS_URL=ws://localhost:7880

# Twilio (for phone OTP) - Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Google Maps API - Get from https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Stripe (payments) - Get from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Storage (Azure Blob Storage for now, can switch to AWS S3 later)
STORAGE_PROVIDER=local  # local, azure, aws, gcp
# Azure Blob Storage (when STORAGE_PROVIDER=azure)
# AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
# AWS S3 (when STORAGE_PROVIDER=aws)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=myride-uploads
# AWS_REGION=us-east-1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

